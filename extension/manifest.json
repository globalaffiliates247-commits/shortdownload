{
  "manifest_version": 3,
  "name": "TAIO Cookie Exporter",
  "version": "1.0.0",
  "description": "Xuất Cookies chuẩn định dạng Netscape cho yt-dlp, curl và TAIO Studio - An toàn & Riêng tư 100%.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "cookies",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
